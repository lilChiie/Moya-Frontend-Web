{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/spa",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://coronary-moonstone-grain.ngrok-free.dev/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://coronary-moonstone-grain.ngrok-free.dev/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "ngrok-skip-browser-warning",
          "value": "true"
        }
      ]
    }
  ]
}
