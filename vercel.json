{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/spa",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://coronary-moonstone-grain.ngrok-free.dev/api/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "https://coronary-moonstone-grain.ngrok-free.dev/static/$1?ngrok-skip-browser-warning=true"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://coronary-moonstone-grain.ngrok-free.dev/static/uploads/$1?ngrok-skip-browser-warning=true"
    },
    {
      "source": "/((?!api|static|uploads|assets|favicon.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
